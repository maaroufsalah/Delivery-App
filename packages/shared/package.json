{
  "name": "@delivery/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./src/index.ts"
    },
    "./statuses": {
      "require": {
        "types": "./dist/statuses.d.ts",
        "default": "./dist/statuses.js"
      },
      "default": "./src/statuses.ts"
    },
    "./themes": {
      "require": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "default": "./src/themes.ts"
    },
    "./mocks": {
      "require": {
        "types": "./dist/mocks/index.d.ts",
        "default": "./dist/mocks/index.js"
      },
      "default": "./src/mocks/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@delivery/config": "workspace:*",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ]
}
