# Pile Wimo-Delivery .NET — copier en /opt/wimo-delivery/app-dotnet.env (chmod 600), hors Git.
APP_VERSION=<commit court>
POSTGRES_USER=wimo
POSTGRES_PASSWORD=<généré : openssl rand -hex 24>
POSTGRES_DB=wimo_dotnet
# Ports hôte (127.0.0.1) : 3112/3113 pour la recette avant bascule, 3102/3103 après.
WEB_HOST_PORT=3112
API_HOST_PORT=3113
WEB_ORIGIN=https://new.wimodelivery.ma
PUBLIC_API_URL=https://api-new.wimodelivery.ma/api
PLATFORM_DOMAIN=wimodelivery.ma
COOKIE_DOMAIN=
COOKIE_SECURE=true
JWT_ACCESS_SECRET=<généré : openssl rand -hex 48>
JWT_REFRESH_SECRET=<généré : openssl rand -hex 48>
LUCKYPENNY_LICENSE_KEY=
# Compte de recette (super-admin temporaire), désactivé après la recette.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
