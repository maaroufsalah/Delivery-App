# ---------------------------------------------------------------------------
# Front — environnement de PRODUCTION
#
# Copier en `apps/web/.env.production` SUR LE VPS.
#
#   cp apps/web/.env.production.example apps/web/.env.production
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# API_URL est défini par docker-compose.prod.yml (`http://api:3001/api`) : le
# front joint l'API par le réseau interne de la pile, sans repasser par l'hôte
# ni par le TLS. Ne le surcharger ici que hors Docker.

# Figé DANS le bundle client au moment du build, pas lu à l'exécution : le
# changer suppose de reconstruire l'image. Il n'est qu'un repli — le front ne
# parle à l'API que depuis le serveur (DECISIONS D-018), donc `API_URL` prime.
# Passé au build par l'argument du même nom dans docker-compose.prod.yml.
NEXT_PUBLIC_API_URL="https://exemple.ma/api"

# Domaine de la PLATEFORME — C8 bloc 5.
#
# `<slug>.<ce domaine>` désigne un espace client ; le domaine NU sert la landing
# de Nocido et son formulaire de demande d'essai. Le front s'en sert pour
# composer les liens de la console et pour reconnaître le domaine nu — jamais
# pour isoler quoi que ce soit : c'est l'API qui résout le tenant depuis l'hôte
# réel de la requête (DECISIONS D-049).
#
# Figé dans le bundle au BUILD, comme NEXT_PUBLIC_API_URL : le changer suppose
# de reconstruire l'image.
NEXT_PUBLIC_PLATFORM_DOMAIN="delivery.nocido.com"
NEXT_TELEMETRY_DISABLED=1

# Sous-domaine d'un espace SUPPRIMÉ — chantier « Purge de speedy ».
#
# `<slug>.<domaine>` dont l'API répond « espace inconnu » : avec cette origine,
# le visiteur y est renvoyé (307) ; vide, il reçoit un 404. Lu à l'EXÉCUTION.
# UNKNOWN_TENANT_REDIRECT="https://speedy.delivery.nocido.com"
