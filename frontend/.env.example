# Front Wimo — copier en frontend/.env.local en développement.
# URL de l'API .NET vue par le serveur Next (les Server Actions parlent à l'API).
API_URL=http://localhost:5080/api
NEXT_PUBLIC_API_URL=http://localhost:5080/api
# Domaine de la plateforme (repris de Speedy ; mono-société côté Wimo).
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
NEXT_TELEMETRY_DISABLED=1
