# dependencies
node_modules/
.pnpm-store/

# build
.next/
out/
dist/
build/
.turbo/

# typescript
*.tsbuildinfo
next-env.d.ts

# env — aucun secret n'entre dans le dépôt. Seuls les .example sont suivis.
# Les motifs sans `/` s'appliquent à TOUTE profondeur : `apps/mobile/.env` est
# couvert par celui-ci, il n'y a pas de second fichier à tenir.
.env
.env.*
!.env.*.example
!.env.example

# expo — cache local d'EAS. `.expo/` porte l'état de la session et des builds ;
# rien de secret, mais rien de partageable non plus.
.expo/
mobile/android/
mobile/ios/

# editors / os
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# claude
.claude/settings.local.json

# Notes de travail locales — elles portent des mots de passe de démonstration
# et les identifiants Swagger. Jamais dans le dépôt (SEC-25 : toute note, pas
# seulement celle-là).
Notes-DeliveryPlatform.txt
Notes-*.txt

# Dumps, archives de pièces jointes, APK construits ou servis : des artefacts
# de production, jamais des sources (SEC-25).
*.dump
*.apk
public-apk/
.recette-fixture.json

# generated by the next-intl plugin
**/messages/*.d.json.ts

# Fichiers sources des comptes (Excel du client) et fichier des comptes générés
# par scripts/seed-uat-comptes.ts : des données personnelles et des mots de
# passe. Jamais dans le dépôt (chantier UAT SpeedyTrans).
docs/seed/
/seed/
comptes-uat.xlsx

# Dumps de sauvegarde produits par backup.sh sur le VPS.
backups/

# Pièces jointes écrites par le stockage local en développement — le volume
# persistant vit sur le VPS, jamais dans le dépôt.
api/var/
uploads/

# État de la rétention des images d'une pile du VPS (scripts/deploy-retention.sh).
.deploy-images

# .NET
bin/
obj/
*.user
TestResults/
