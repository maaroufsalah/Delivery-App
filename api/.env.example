# API .NET Wimo — variables lues par ASP.NET Core (env > appsettings).
ConnectionStrings__Default=Host=localhost;Port=5434;Database=wimo_delivery;Username=wimo;Password=wimo
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-long-refresh
# Cookies dp.at / dp.rt
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Migrations + seed idempotent (société Wimo, permissions, super-admin) au démarrage
MIGRATE_ON_STARTUP=true
SEED_ADMIN_EMAIL=admin@wimo.ma
SEED_ADMIN_PASSWORD=
WEB_ORIGIN=http://localhost:3000
UPLOADS_DIR=./var/uploads
# Clé Community MediatR / AutoMapper (jamais commitée).
LUCKYPENNY_LICENSE_KEY=
